# ============================================================
# JLPT AI Tutor - Environment Variables Template
# Copy this file to .env (backend) and frontend/.env.local (frontend)
# DO NOT commit real secrets to Git!
# ============================================================

# === AI Engine Configuration (Groq / Gemini) ===
# Groq API Key (recommended, fast & free): https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key (alternative): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-1.5-flash

# AI Rate Limits & Parameters
AI_MAX_INPUT_TOKENS=2048
AI_MAX_OUTPUT_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=10000

AI_STREAMING_ENABLED=true
AI_CONVERSATION_ENABLED=true
AI_WRITING_CHECK_ENABLED=true

# === Supabase Database (PostgreSQL) ===
# Copy from Supabase Settings -> Database -> Connection string -> JDBC
# Use session pooler (Port 5432) or transaction pooler (Port 6543)
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DB_PASSWORD

# === Supabase Auth ===
# Copy from Supabase Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...your_anon_public_key
SUPABASE_JWT_SECRET=your_jwt_secret_here

# === Spring Profile ===
# Set to 'prod' for Supabase PostgreSQL + Supabase Auth
SPRING_PROFILES_ACTIVE=prod
