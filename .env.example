# AI API Credentials
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (Supabase PostgreSQL or Local Postgres)
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# Supabase Auth Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# JWT Secret (required — no default, app will fail to start without it)
JWT_SECRET=your_jwt_secret_key_here

# Comma-separated list of origins allowed to call the API (defaults to http://localhost:5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Active Spring Profile (prod for Supabase PostgreSQL, dev for H2 local)
SPRING_PROFILES_ACTIVE=prod

# RAG (Retrieval-Augmented Generation) — requires pgvector migration to be run first
# Set RAG_ENABLED=true after running supabase/migrations/03_enable_pgvector.sql
# and triggering indexing via POST /api/admin/rag/index
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_ENABLED=false
RAG_TOP_K=3
